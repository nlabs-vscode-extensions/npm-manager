{
  "name": "nlabs-npm-manager",
  "displayName": "nLabs NPM Manager",
  "description": "NPM package manager for Node.js projects — search, install, update and remove packages across all workspace projects.",
  "version": "0.1.0",
  "publisher": "nlabs",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nlabs-vscode-extensions/npm-manager"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": ["Other", "Programming Languages"],
  "keywords": ["npm", "node", "nodejs", "package manager", "nlabs"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nlabs-npm.openManager",
        "title": "nLabs: NPM Manager",
        "icon": "$(package)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "nlabs-npm.openManager",
          "when": "explorerResourceIsFolder || resourceFilename == package.json",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "nlabs-npm.openManager",
          "when": "resourceFilename == package.json",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "nLabs NPM Manager",
      "properties": {
        "nlabsNpm.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "tr", "en", "de", "fr"],
          "enumDescriptions": ["Auto-detect from VS Code locale", "Türkçe", "English", "Deutsch", "Français"],
          "description": "Display language for nLabs NPM Manager"
        },
        "nlabsNpm.packageManager": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "npm", "yarn", "pnpm"],
          "enumDescriptions": ["Auto-detect from lock file", "npm", "yarn", "pnpm"],
          "description": "Package manager to use for install/remove/update"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"test/*.test.js\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/vscode": "^1.118.0",
    "typescript": "^5.9.3",
    "@vscode/vsce": "^3.0.0"
  }
}
